# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Tooling caches
.mypy_cache/
.ruff_cache/
.pytest_cache/
.hypothesis/
.coverage
htmlcov/

# Runs, checkpoints and scratch output.
# `results/` is deliberately NOT ignored: committed figures/tables are the
# source of truth for every number quoted in the docs (Part F5 of the spec).
runs/
checkpoints/
*.pt
*.bin
*.safetensors

# ...except the published inference-only models. These are stripped of optimizer state
# by `scripts/export_models.py` and committed so the demo, the notebooks and a fresh
# clone all work without a model hub or a retraining step. They are derived artifacts:
# `results/` remains the source of truth for every reported number.
!artifacts/models/*.pt
wandb/
site/

# Downloaded / generated corpora. Never committed: `scripts/fetch_tinystories.py`
# re-fetches TinyStories by HTTP range request, and the toy corpus is generated
# deterministically from a seed, so both are reproducible rather than stored.
data/toy/
data/cache/
data/tinystories/

# OS
.DS_Store
